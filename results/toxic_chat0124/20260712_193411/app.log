import tensorflow as tf

def create_combined_model(input_shape):
    inputs = tf.keras.layers.Input(shape=input_shape)

    x = tf.keras.layers.Conv1D(120, kernel_size=3, activation='relu', padding='same')(inputs)
    x = tf.keras.layers.MaxPooling1D(pool_size=2)(x)
    x = tf.keras.layers.Conv1D(120, kernel_size=3, activation='relu', padding='same')(x)
    x = tf.keras.layers.MaxPooling1D(pool_size=2)(x)

    x = tf.keras.layers.GRU(120, return_sequences=True)(x)
    x = tf.keras.layers.GRU(120, return_sequences=True)(x)
    x = tf.keras.layers.GRU(120)(x)

    clf_output = tf.keras.layers.Dense(1, activation="sigmoid", name="clf_output")(x)
    reg_output = tf.keras.layers.Dense(1, name="reg_output")(x)

    model = tf.keras.models.Model(inputs=inputs, outputs=[clf_output, reg_output])

    return model
